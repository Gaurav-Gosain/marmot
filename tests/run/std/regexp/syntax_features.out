^abc$              "abc" "abc"
a.c                "a\nc" ""
(?s)a.c            "a\nc" "a\nc"
(?i)hello          "HeLLo" "HeLLo"
(?m)^b$            "a\nb\nc" "b"
\bword\b           "a word here" "word"
[^aeiou\s]+        "hello world" "h"
a{2,3}             "aaaa" "aaa"
a+?                "aaa" "a"
(a|ab)(c|bcd)      "abcd" "abcd"
\p{L}+             "héllo wörld" "héllo"
[[:alpha:]]+       "abc123" "abc"
\d+(\.\d+)?        "pi 3.14159" "3.14159"
^$                 "" ""
(?U)a+             "aaa" "a"
[\p{Han}]+         "x世界y" "世界"
